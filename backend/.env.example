# WorkHub Enterprise Platform Environment Configuration
PROJECT_NAME="WorkHub – Enterprise Work Management & IT Service Desk"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-workhub-jwt-key-2026-production-grade"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL 8+ Database Configuration (Primary Relational Database)
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=workhub

# SQLAlchemy Database URL:
# For MySQL: mysql+pymysql://root:password@localhost:3306/workhub?charset=utf8mb4
# For Local Development / Fallback: sqlite:///./workhub.db
DATABASE_URL=mysql+pymysql://root:@localhost:3306/workhub?charset=utf8mb4

# File Upload Configuration
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=10485760
